<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.7">
  <model name="low_profile_robot">
    <link name="base_footprint">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>.01</mass>
        <inertia>
          <ixx>.001</ixx>
          <iyy>.001</iyy>
          <izz>.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <link name="chassis">
      <pose>0 0 .10 0 0 0</pose>
      <inertial>
        <mass>8</mass>
        <inertia>
          <ixx>.12</ixx>
          <iyy>.18</iyy>
          <izz>.25</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry>
          <box>
            <size>.48 .38 .10</size>
          </box>
        </geometry>
      </collision>
      <visual name="body_visual">
        <geometry>
          <box>
            <size>.48 .38 .10</size>
          </box>
        </geometry>
        <material>
          <ambient>.8 .15 .15 1</ambient>
          <diffuse>.8 .15 .15 1</diffuse>
        </material>
      </visual>
      <sensor name="body_contact" type="contact">
        <contact>
          <collision>body_collision</collision>
          <topic>/assessment/body_contacts</topic>
        </contact>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
      </sensor>
      <sensor name="front_rplidar_a2" type="gpu_lidar">
        <pose>.15 0 .065 0 0 0</pose>
        <ignition_frame_id>front_laser</ignition_frame_id>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>.08</min>
            <max>15</max>
            <resolution>.01</resolution>
          </range>
        </ray>
      </sensor>
      <sensor name="navigation_lidar3d" type="gpu_lidar">
        <pose>.15 0 .065 0 0 0</pose>
        <ignition_frame_id>navigation_laser</ignition_frame_id>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-.610865</min_angle>
              <max_angle>.610865</max_angle>
            </vertical>
          </scan>
          <range>
            <min>.08</min>
            <max>15</max>
            <resolution>.01</resolution>
          </range>
        </ray>
      </sensor>
      <sensor name="chassis_imu" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <ignition_frame_id>body</ignition_frame_id>
        <always_on>true</always_on>
        <update_rate>200</update_rate>
      </sensor>
    </link>
    <joint name="base_to_chassis" type="fixed">
      <parent>base_footprint</parent>
      <child>chassis</child>
      <pose relative_to="base_footprint">0 0 .10 0 0 0</pose>
    </joint>
    <link name="front_left_wheel">
      <pose>0.18 0.15 .035 0 0 0</pose>
      <inertial>
        <mass>.1</mass>
        <inertia>
          <ixx>.0001</ixx>
          <iyy>.0001</iyy>
          <izz>.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="front_left_collision">
        <geometry>
          <sphere>
            <radius>.035</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>.01</mu>
              <mu2>.01</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="front_left_visual">
        <geometry>
          <sphere>
            <radius>.035</radius>
          </sphere>
        </geometry>
      </visual>
    </link>
    <joint name="front_left_wheel_joint" type="fixed">
      <parent>chassis</parent>
      <child>front_left_wheel</child>
      <pose relative_to="chassis">0.18 0.15 -.065 0 0 0</pose>
    </joint>
    <link name="front_right_wheel">
      <pose>0.18 -0.15 .035 0 0 0</pose>
      <inertial>
        <mass>.1</mass>
        <inertia>
          <ixx>.0001</ixx>
          <iyy>.0001</iyy>
          <izz>.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="front_right_collision">
        <geometry>
          <sphere>
            <radius>.035</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>.01</mu>
              <mu2>.01</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="front_right_visual">
        <geometry>
          <sphere>
            <radius>.035</radius>
          </sphere>
        </geometry>
      </visual>
    </link>
    <joint name="front_right_wheel_joint" type="fixed">
      <parent>chassis</parent>
      <child>front_right_wheel</child>
      <pose relative_to="chassis">0.18 -0.15 -.065 0 0 0</pose>
    </joint>
    <link name="rear_left_wheel">
      <pose>-0.18 0.15 .035 0 0 0</pose>
      <inertial>
        <mass>.1</mass>
        <inertia>
          <ixx>.0001</ixx>
          <iyy>.0001</iyy>
          <izz>.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="rear_left_collision">
        <geometry>
          <sphere>
            <radius>.035</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>.01</mu>
              <mu2>.01</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="rear_left_visual">
        <geometry>
          <sphere>
            <radius>.035</radius>
          </sphere>
        </geometry>
      </visual>
    </link>
    <joint name="rear_left_wheel_joint" type="fixed">
      <parent>chassis</parent>
      <child>rear_left_wheel</child>
      <pose relative_to="chassis">-0.18 0.15 -.065 0 0 0</pose>
    </joint>
    <link name="rear_right_wheel">
      <pose>-0.18 -0.15 .035 0 0 0</pose>
      <inertial>
        <mass>.1</mass>
        <inertia>
          <ixx>.0001</ixx>
          <iyy>.0001</iyy>
          <izz>.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="rear_right_collision">
        <geometry>
          <sphere>
            <radius>.035</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>.01</mu>
              <mu2>.01</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="rear_right_visual">
        <geometry>
          <sphere>
            <radius>.035</radius>
          </sphere>
        </geometry>
      </visual>
    </link>
    <joint name="rear_right_wheel_joint" type="fixed">
      <parent>chassis</parent>
      <child>rear_right_wheel</child>
      <pose relative_to="chassis">-0.18 -0.15 -.065 0 0 0</pose>
    </joint>
    <plugin filename="MecanumDrive2" name="ignition::gazebo::systems::MecanumDrive2">
      <chassis_link>chassis</chassis_link>
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <rear_left_joint>rear_left_wheel_joint</rear_left_joint>
      <rear_right_joint>rear_right_wheel_joint</rear_right_joint>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher" />
  </model>
</sdf>